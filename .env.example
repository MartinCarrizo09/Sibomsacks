# Puerto HTTP (Railway lo inyecta automaticamente)
PORT=3000

# URL publica del sitio. En Railway se deduce de RAILWAY_PUBLIC_DOMAIN;
# definila solo si usas un dominio propio.
# PUBLIC_BASE_URL=https://www.sibomsacks.com

# Origenes extra permitidos por CORS, separados por coma.
# CORS_ORIGINS=https://www.sibomsacks.com

# Directorio de las bases SQLite (en Railway apunta al volumen montado).
SQLITE_DATA_DIR=/app/backend/data

# El formulario de contacto no envia correo: las consultas llegan por
# WhatsApp, al numero configurado en el frontend.
