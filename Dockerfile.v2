# syntax=docker/dockerfile:1
#
# Imagen del frontend-v2. Misma API que el sitio actual, pero sirviendo
# la interfaz nueva. Se despliega como un servicio aparte para poder
# comparar los dos en paralelo.

# ---- Etapa 1: build del frontend nuevo ----
FROM node:20-slim AS frontend
WORKDIR /app/frontend-v2
COPY frontend-v2/package.json frontend-v2/package-lock.json ./
RUN npm ci
COPY frontend-v2/ ./
RUN npm run build

# ---- Etapa 2: dependencias de produccion del backend ----
FROM node:20-slim AS deps
WORKDIR /app/backend
COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev

# ---- Etapa 3: runtime ----
FROM node:20-slim AS runtime
ENV NODE_ENV=production
WORKDIR /app/backend

COPY --from=deps /app/backend/node_modules ./node_modules
COPY backend/ ./
# El SPA compilado se sirve desde backend/dist
COPY --from=frontend /app/frontend-v2/dist ./dist

# Copia semilla de las bases SQLite, para poblar el volumen la primera vez
RUN mkdir -p /app/seed-data && cp data/*.sqlite /app/seed-data/

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

EXPOSE 3000
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["node", "app.js"]
